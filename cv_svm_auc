repeat_svm_cv <- function(
        df,
        predictors = c("x1", "x2", "x3"),
        outcome = "group",
        kernel = "radial",
        cost = 1,
        gamma = NULL,
        number_repeats = 100,
        number_folds = 5
) {
    
    # Required packages
    require(e1071)
    require(pROC)
    
    # =========================================================
    # 0. BASIC CHECKS
    # =========================================================
    
    if (!all(c(outcome, "age", predictors) %in% names(df))) {
        missing_vars <- setdiff(
            c(outcome, "age", predictors),
            names(df)
        )
        
        stop(
            paste(
                "The following variables are missing:",
                paste(missing_vars, collapse = ", ")
            )
        )
    }
    
    dat <- df[, c(outcome, "age", predictors), drop = FALSE]
    dat <- na.omit(dat)
    
    # Convert outcome to factor BEFORE splitting into train/test
    dat[[outcome]] <- factor(dat[[outcome]])
    
    y <- dat[[outcome]]
    
    y <- factor(dat[[outcome]])
    
    if (length(unique(y)) != 2) {
        stop("Outcome must contain exactly two groups.")
    }
    
    if (any(table(y) < number_folds)) {
        stop(
            paste(
                "At least one outcome group has fewer observations than",
                number_folds,
                "required folds."
            )
        )
    }
    
    # Make sure predictors are numeric
    for (v in predictors) {
        if (!is.numeric(dat[[v]])) {
            stop(
                paste(
                    "Predictor", v,
                    "must be numeric."
                )
            )
        }
    }
    
    if (!is.numeric(dat$age)) {
        stop("age must be numeric.")
    }
    
    # Initial diagnostic information
    cat("\n========================================\n")
    cat("INITIAL DATA CHECK\n")
    cat("========================================\n")
    
    cat("Outcome:", outcome, "\n")
    cat("Outcome levels:\n")
    print(levels(y))
    
    cat("\nOutcome distribution:\n")
    print(table(y))
    
    cat("\nNumber of complete observations:", nrow(dat), "\n")
    cat("Number of predictors:", length(predictors), "\n")
    cat("Predictors:\n")
    print(predictors)
    
    cat("========================================\n\n")
    
    
    # =========================================================
    # STORE RESULTS
    # =========================================================
    
    repeat_auc <- numeric(number_repeats)
    
    # =========================================================
    # REPEATED CV
    # =========================================================
    
    for (r in 1:number_repeats) {
        
        # -------------------------------------------------------
        # 1. STRATIFIED K-FOLD SPLIT
        # -------------------------------------------------------
        
        fold_id <- integer(nrow(dat))
        
        for (g in levels(y)) {
            
            idx <- which(y == g)
            
            idx <- sample(idx, length(idx))
            
            fold_id[idx] <- rep(
                1:number_folds,
                length.out = length(idx)
            )
        }
        
        fold_auc <- numeric(number_folds)
        
        # -------------------------------------------------------
        # K FOLDS
        # -------------------------------------------------------
        
        for (k in 1:number_folds) {
            
            cat(
                "Repeat", r,
                "/", number_repeats,
                "- Fold", k,
                "/", number_folds,
                "\n"
            )
            
            train_idx <- which(fold_id != k)
            test_idx  <- which(fold_id == k)
            
            train <- dat[train_idx, , drop = FALSE]
            test  <- dat[test_idx, , drop = FALSE]
            
            
            # =====================================================
            # 1. AGE RESIDUALIZATION
            # =====================================================
            
            train_x <- matrix(
                NA_real_,
                nrow = nrow(train),
                ncol = length(predictors)
            )
            
            test_x <- matrix(
                NA_real_,
                nrow = nrow(test),
                ncol = length(predictors)
            )
            
            colnames(train_x) <- predictors
            colnames(test_x) <- predictors
            
            for (j in seq_along(predictors)) {
                
                v <- predictors[j]
                
                # Fit age relationship ONLY in training data
                age_model <- lm(
                    train[[v]] ~ train$age
                )
                
                # Training residuals
                train_x[, j] <- residuals(age_model)
                
                # Apply SAME fitted relationship to test data
                beta <- coef(age_model)
                
                test_pred <- beta[1] +
                    beta[2] * test$age
                
                test_x[, j] <- test[[v]] - test_pred
            }
            
            
            # =====================================================
            # DEBUG: CHECK RESIDUALIZATION
            # =====================================================
            
            if (
                any(!is.finite(train_x)) ||
                any(!is.finite(test_x))
            ) {
                
                cat("\n==============================\n")
                cat("ERROR: INVALID RESIDUALIZED DATA\n")
                cat("Repeat:", r, "\n")
                cat("Fold:", k, "\n")
                cat("Train rows:", nrow(train), "\n")
                cat("Test rows:", nrow(test), "\n")
                cat("==============================\n\n")
                
                stop(
                    paste(
                        "Non-finite values after age residualization.",
                        "Repeat", r,
                        "Fold", k
                    )
                )
            }
            
            
            # =====================================================
            # 2. FEATURE SELECTION
            #    TRAINING DATA ONLY
            # =====================================================
            
            p_values <- numeric(length(predictors))
            
            for (j in seq_along(predictors)) {
                
                tmp <- data.frame(
                    x = train_x[, j],
                    y = train[[outcome]]
                )
                
                p_values[j] <- tryCatch(
                    t.test(
                        x ~ y,
                        data = tmp
                    )$p.value,
                    error = function(e) NA_real_
                )
            }
            
            # Bonferroni correction
            p_adj <- p.adjust(
                p_values,
                method = "bonferroni"
            )
            
            selected <- predictors[
                !is.na(p_adj) &
                    p_adj < 0.05
            ]
            
            
            # =====================================================
            # DEBUG: FEATURE SELECTION
            # =====================================================
            
            cat("  Selected features:",
                length(selected), "\n")
            
            if (length(selected) > 0) {
                cat(
                    "  ",
                    paste(selected, collapse = ", "),
                    "\n"
                )
            }
            
            # -----------------------------------------------------
            # No predictors survived
            # -----------------------------------------------------
            
            if (length(selected) == 0) {
                
                warning(
                    paste(
                        "Repeat", r,
                        "Fold", k,
                        ": no predictors survived Bonferroni correction."
                    )
                )
                
                fold_auc[k] <- NA_real_
                next
            }
            
            
            # =====================================================
            # KEEP SELECTED VARIABLES
            # =====================================================
            
            train_x_sel <- train_x[
                , selected,
                drop = FALSE
            ]
            
            test_x_sel <- test_x[
                , selected,
                drop = FALSE
            ]
            # Gamma based on the number of features actually entering SVM
            gamma_fold <- 1 / ncol(train_x_sel)
            
            cat(
                "  Final number of features:",
                ncol(train_x_sel),
                "\n"
            )
            
            cat(
                "  Gamma:",
                gamma_fold,
                "\n"
            )
            
            # =====================================================
            # 3. STANDARDIZATION
            #    TRAINING DATA ONLY
            # =====================================================
            
            train_mean <- apply(
                train_x_sel,
                2,
                mean
            )
            
            train_sd <- apply(
                train_x_sel,
                2,
                sd
            )
            
            # Remove zero-variance predictors
            keep <- (
                train_sd > 0 &
                    !is.na(train_sd) &
                    is.finite(train_sd)
            )
            
            train_x_sel <- train_x_sel[
                , keep,
                drop = FALSE
            ]
            
            test_x_sel <- test_x_sel[
                , keep,
                drop = FALSE
            ]
            
            train_mean <- train_mean[keep]
            train_sd   <- train_sd[keep]
            
            
            # -----------------------------------------------------
            # Check whether anything remains
            # -----------------------------------------------------
            
            if (ncol(train_x_sel) == 0) {
                
                warning(
                    paste(
                        "Repeat", r,
                        "Fold", k,
                        ": no non-zero-variance predictors remain."
                    )
                )
                
                fold_auc[k] <- NA_real_
                next
            }
            
            
            # Standardize using training parameters
            train_x_scaled <- scale(
                train_x_sel,
                center = train_mean,
                scale = train_sd
            )
            
            test_x_scaled <- scale(
                test_x_sel,
                center = train_mean,
                scale = train_sd
            )
            
            
            # =====================================================
            # DEBUG: CHECK STANDARDIZATION
            # =====================================================
            
            if (
                any(!is.finite(train_x_scaled)) ||
                any(!is.finite(test_x_scaled))
            ) {
                
                cat("\n==============================\n")
                cat("ERROR: INVALID SCALED DATA\n")
                cat("Repeat:", r, "\n")
                cat("Fold:", k, "\n")
                
                cat("\nSelected features:\n")
                print(selected[keep])
                
                cat("\nTraining means:\n")
                print(train_mean)
                
                cat("\nTraining SD:\n")
                print(train_sd)
                
                cat("==============================\n\n")
                
                stop(
                    paste(
                        "Non-finite values after scaling.",
                        "Repeat", r,
                        "Fold", k
                    )
                )
            }
            
            
            # =====================================================
            # 4. SVM FITTING
            # =====================================================
            
            svm_args <- list(
                x = train_x_scaled,
                y = train[[outcome]],
                kernel = kernel,
                cost = cost,
                gamma= gamma_fold
            )
            
            if (!is.null(gamma)) {
                svm_args$gamma <- gamma
            }
            
            svm_model <- tryCatch(
                do.call(
                    e1071::svm,
                    svm_args
                ),
                error = function(e) {
                    
                    cat("\n==============================\n")
                    cat("ERROR: SVM FITTING FAILED\n")
                    cat("Repeat:", r, "\n")
                    cat("Fold:", k, "\n")
                    cat("Selected features:\n")
                    print(selected[keep])
                    cat("\nSVM error:\n")
                    print(e)
                    cat("==============================\n\n")
                    
                    stop(e)
                }
            )
            
            
            # =====================================================
            # 5. PREDICT HELD-OUT FOLD
            #    USING SVM DECISION VALUES
            # =====================================================
            
            pred <- predict(
                svm_model,
                test_x_scaled,
                decision.values = TRUE
            )
            
            decision_values <- attr(
                pred,
                "decision.values"
            )
            
            
            # =====================================================
            # DEBUG: DECISION VALUES
            # =====================================================
            
            if (is.null(decision_values)) {
                
                cat("\n==============================\n")
                cat("ERROR: DECISION VALUES ARE NULL\n")
                cat("Repeat:", r, "\n")
                cat("Fold:", k, "\n")
                
                cat("\nSVM levels:\n")
                print(svm_model$levels)
                
                cat("\nPrediction:\n")
                print(pred)
                
                cat("==============================\n\n")
                
                stop(
                    paste(
                        "Decision values are NULL.",
                        "Repeat", r,
                        "Fold", k
                    )
                )
            }
            
            test_score <- as.numeric(
                decision_values
            )
            
            
            # =====================================================
            # DEBUG: PREDICTION OUTPUT
            # =====================================================
            
            cat("  SVM classes:",
                paste(svm_model$levels, collapse = ", "),
                "\n")
            
            cat(
                "  Test outcome distribution:\n"
            )
            
            print(
                table(
                    test[[outcome]],
                    useNA = "ifany"
                )
            )
            
            cat(
                "  Score summary:\n"
            )
            
            print(
                summary(test_score)
            )
            
            cat(
                "  Number of NA scores:",
                sum(is.na(test_score)),
                "\n"
            )
            
            
            # =====================================================
            # 6. AUC FOR HELD-OUT FOLD
            # =====================================================
            
            response_test <- factor(
                test[[outcome]],
                levels = svm_model$levels
            )
            
            valid <- complete.cases(
                response_test,
                test_score
            )
            
            
            # -----------------------------------------------------
            # DEBUG: VALID ROC DATA
            # -----------------------------------------------------
            
            cat(
                "  Valid ROC observations:",
                sum(valid),
                "/",
                length(valid),
                "\n"
            )
            
            if (sum(valid) == 0) {
                
                cat("\n==============================\n")
                cat("ERROR: NO VALID DATA FOR ROC\n")
                cat("Repeat:", r, "\n")
                cat("Fold:", k, "\n")
                
                cat("\nOutcome levels:\n")
                print(levels(response_test))
                
                cat("\nOutcome distribution:\n")
                print(
                    table(
                        response_test,
                        useNA = "ifany"
                    )
                )
                
                cat("\nScore summary:\n")
                print(summary(test_score))
                
                cat("\nNumber of NA scores:\n")
                print(sum(is.na(test_score)))
                
                cat("==============================\n\n")
                
                fold_auc[k] <- NA_real_
                next
            }
            
            
            # Check both classes are represented
            if (
                length(unique(response_test[valid])) != 2
            ) {
                
                cat("\n==============================\n")
                cat("ERROR: ONLY ONE CLASS IN TEST FOLD\n")
                cat("Repeat:", r, "\n")
                cat("Fold:", k, "\n")
                
                print(
                    table(
                        response_test[valid]
                    )
                )
                
                cat("==============================\n\n")
                
                fold_auc[k] <- NA_real_
                next
            }
            
            
            # ROC
            roc_obj <- pROC::roc(
                response = response_test[valid],
                predictor = test_score[valid],
                levels = svm_model$levels,
                direction = ">",
                quiet = TRUE
            )
            
            fold_auc[k] <- as.numeric(
                pROC::auc(roc_obj)
            )
            
            
            # =====================================================
            # FOLD RESULT
            # =====================================================
            
            cat(
                "  Fold AUC:",
                round(fold_auc[k], 4),
                "\n\n"
            )
        }
        
        
        # =======================================================
        # 7. AVERAGE THE 5 FOLD AUCs
        # =======================================================
        
        repeat_auc[r] <- mean(
            fold_auc,
            na.rm = TRUE
        )
        
        cat(
            ">>> Repeat", r,
            "mean AUC:",
            round(repeat_auc[r], 4),
            "\n"
        )
        
        cat(
            "    Fold AUCs:",
            paste(
                round(fold_auc, 4),
                collapse = ", "
            ),
            "\n\n"
        )
    }
    
    
    # =========================================================
    # 8. 100 REPEAT-LEVEL AUCs
    #    → MEAN + 95% CI
    # =========================================================
    
    # =========================================================
    # 8. 100 REPEAT-LEVEL AUCs
    #    → MEAN + EMPIRICAL 95% CI
    # =========================================================
    
    valid_repeat <- !is.na(repeat_auc)
    
    repeat_auc_valid <- repeat_auc[valid_repeat]
    
    mean_auc <- mean(
        repeat_auc_valid
    )
    
    # Empirical 95% CI:
    # 2.5th and 97.5th percentiles of the
    # 100 repeat-level mean AUCs
    ci <- quantile(
        repeat_auc_valid,
        probs = c(0.025, 0.975),
        na.rm = TRUE,
        names = FALSE,
        type = 7
    )
    
    ci_lower <- ci[1]
    ci_upper <- ci[2]
    
    n <- length(repeat_auc_valid)
    # =========================================================
    # FINAL RESULT
    # =========================================================
    
    cat("\n========================================\n")
    cat("FINAL RESULTS\n")
    cat("========================================\n")
    
    cat(
        "Valid repeats:",
        n,
        "/",
        number_repeats,
        "\n"
    )
    
    cat(
        "Mean AUC:",
        round(mean_auc, 4),
        "\n"
    )
    
    cat(
        "Empirical 95% CI:",
        round(ci_lower, 4),
        "-",
        round(ci_upper, 4),
        "\n"
    )
    
    cat("========================================\n")
    
    return(
        list(
            average_auc = mean_auc,
            auc_95CI_lower = ci_lower,
            auc_95CI_upper = ci_upper,
            auc_95CI = c(
                ci_lower,
                ci_upper
            ),
            repeat_auc = repeat_auc
        )
    )
}
